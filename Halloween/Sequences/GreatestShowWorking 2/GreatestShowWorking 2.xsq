    <Element type="timing" name="BARNUM/CARLYLE">
      <EffectLayer>
        <Effect label="Ladies and gents this is the moment you've waited for" startTime="22350" endTime="25450" />
        <Effect label="Been searching in the dark, your sweat soaking through the floor" startTime="28200" endTime="31650" />
        <Effect label="And buried in your bones there's an ache that you can't ignore" startTime="34450" endTime="38000" />
        <Effect label="Taking your breath" startTime="38000" endTime="39350" />
        <Effect label="stealing your mind" startTime="39350" endTime="40650" />
        <Effect label="Huh, And all that was real is left behind" startTime="40650" endTime="44350" />
        <Effect label="Huh Don't fight it, it's coming for you, running at ya" startTime="44350" endTime="47350" />
        <Effect label="Huh It's only this moment, don't care what comes after" startTime="47350" endTime="50550" />
        <Effect label="Your fever dream, can't you see it getting closer" startTime="50550" endTime="53600" />
        <Effect label="Huh Just surrender 'cause you feel the feeling taking over" startTime="53600" endTime="56900" />
        <Effect label="It's fire, it's freedom, it's flooding open" startTime="56900" endTime="59850" />
        <Effect label="Huh It's a preacher in the pulpit and you'll find devotion" startTime="59850" endTime="63100" />
        <Effect label="There's something breaking at the brick of every wall It's holding all that you know so tell me do you wanna go" startTime="63100" endTime="69750" />
        <Effect label="Where it's covered in all the colored lights" startTime="70150" endTime="73050" />
        <Effect label="Where the runaways are running the night" startTime="73050" endTime="75650" />
        <Effect label="Impossible comes true, it's taking over you" startTime="75750" endTime="79050" />
        <Effect label="We light it up, we won't come down" startTime="82000" endTime="85100" />
        <Effect label="Watching it come true, it's taking over you" startTime="88050" endTime="91000" />
        <Effect label="colossal we come these renegades in the ring" startTime="97850" endTime="100950" />
        <Effect label="where the lost get found in the crown of the circus king" startTime="103450" endTime="106950" />
        <Effect label="Don't fight it, it's coming for you, running at ya" startTime="107500" endTime="110150" />
        <Effect label="It's only this moment, don't care what comes after" startTime="110600" endTime="113450" />
        <Effect label="It's blinding, out shining anything that you know" startTime="113500" endTime="116350" />
        <Effect label="Just surrender 'cause you're calling and you wanna go" startTime="116600" endTime="119800" />
        <Effect label="Where it's covered in all the colored lights" startTime="120250" endTime="123250" />
        <Effect label="Where the runaways are running the night" startTime="123250" endTime="125850" />
        <Effect label="Impossible comes true, intoxicating you" startTime="125850" endTime="129150" />
        <Effect label="We light it up, we won't come down" startTime="132150" endTime="135400" />
        <Effect label="Watching it come true, it's taking over you" startTime="138250" endTime="141300" />
        <Effect label="It's everything you ever want It's everything you ever need And it's here right in front of you" startTime="144950" endTime="153600" />
        <Effect label="This is where you wanna be" startTime="154250" endTime="156750" />
        <Effect label="It's everything you ever want It's everything you ever need And it's here right in front of you" startTime="157100" endTime="166000" />
        <Effect label="This is where you wanna be" startTime="166400" endTime="169000" />
        <Effect label="Where the runaways are running the night" startTime="205300" endTime="208000" />
        <Effect label="Impossible comes true, it's taking over you" startTime="208000" endTime="211000" />
