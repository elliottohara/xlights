    <Element type="timing" name="Lyrics">
      <EffectLayer>
        <Effect label="Deep in the bosom of the gentle night" startTime="30575" endTime="33450" />
        <Effect label="Is when I search for the light" startTime="33450" endTime="35100" />
        <Effect label="Pick up my pen and start to write" startTime="35325" endTime="37250" />
        <Effect label="I struggle, I fight dark forces in the clear moonlight" startTime="37250" endTime="40900" />
        <Effect label="Without fear" startTime="41100" endTime="42250" />
        <Effect label="Insomnia" startTime="44050" endTime="44750" />
        <Effect label="I can't get no sleep" startTime="47675" endTime="49725" />
        <Effect label="I used to worry" startTime="78825" endTime="79950" />
        <Effect label="Thought I was going mad in a hurry" startTime="80425" endTime="82775" />
        <Effect label="Getting stressed, making excess mess in darkness" startTime="82775" endTime="86500" />
        <Effect label="No electricity, something's all over me, greasy" startTime="86675" endTime="90775" />
        <Effect label="Insomnia, please release me" startTime="91075" endTime="93375" />
        <Effect label="And let me dream of making mad love to my girl on the heath" startTime="93375" endTime="97950" />
        <Effect label="Tearing off tights with my teeth" startTime="98375" endTime="100600" />
        <Effect label="But there's no release, no peace" startTime="100600" endTime="103150" />
        <Effect label="I toss and turn without cease" startTime="103150" endTime="105300" />
        <Effect label="Like a curse, open my eyes and rise like yeast" startTime="105475" endTime="109025" />
        <Effect label="At least a couple of weeks since I last slept, kept taking sleepers" startTime="109225" endTime="114000" />
        <Effect label="But now I keep myself pepped" startTime="114675" endTime="116550" />
        <Effect label="Deeper still, that night" startTime="116775" endTime="118400" />
        <Effect label="I write by candlelight, I find insight" startTime="118675" endTime="121675" />
        <Effect label="Fundamental movement, huh, so when it's black" startTime="121675" endTime="125125" />
        <Effect label="This insomniac, take an original tack" startTime="125300" endTime="127950" />
        <Effect label="Keep the beast in my nature under ceaseless attack" startTime="128275" endTime="131500" />
        <Effect label="I gets no sleep" startTime="131500" endTime="132975" />
        <Effect label="I can't get no sleep" startTime="134450" endTime="136700" />
